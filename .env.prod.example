# Production environment template for the Nova Marketplace VPS.
#
# This file documents every variable docker-compose.prod.yml expects to
# find in /opt/nova/.env. It contains NO real values — copy it to
# /opt/nova/.env on the VPS by hand and fill in real secrets there. Never
# commit the filled-in file, and never let CI overwrite it on deploy.
#
# Variable names below come directly from backend/internal/config/config.go
# (Config.Load / Config.validate) — nothing here is invented.

# ---- Postgres (consumed directly by the postgres service) ----
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Database connection (consumed by backend + migrate) ----
# Either set DATABASE_URL directly, or the discrete DB_* vars below —
# config.Load() accepts either. DATABASE_URL takes precedence when both are
# present. If using DATABASE_URL, point it at the `postgres` service name
# (the Docker network's internal DNS), e.g.:
#   postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable
DATABASE_URL=

DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable

# ---- Application ----
APP_ENV=production
PORT=8080

# Exact origin CORS allows — must match the frontend's public origin
# exactly (internal/middleware/cors.go never falls back to "*").
FRONTEND_URL=https://kungey-ayuly.kz

# ---- Auth (Stage 9) ----
# HMAC secret for signing access JWTs. Required, minimum 32 characters, or
# the API refuses to start (config.go: minJWTSecretLength). Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# Optional — defaults shown are what config.go falls back to if unset.
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Must be true whenever APP_ENV=production — config.Load() refuses to start
# otherwise (refresh cookie must be HTTPS-only in production).
COOKIE_SECURE=true

# Optional — leave empty for a host-only cookie unless the API and
# frontend are set up to share a parent domain.
COOKIE_DOMAIN=
