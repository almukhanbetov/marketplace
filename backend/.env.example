# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.

APP_ENV=development
PORT=8080

# Discrete DB_* vars are used to build the connection string when
# DATABASE_URL is not set (see below). Convenient for local dev with
# docker compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# If set, DATABASE_URL takes precedence over the DB_* vars above. This is
# the single connection string most hosting providers (Render, Railway,
# Fly.io, etc.) inject in production.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace?sslmode=disable

# Must match the origin the Next.js frontend is served from — CORS allows
# exactly this origin and nothing else.
FRONTEND_URL=http://localhost:3000
