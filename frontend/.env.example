# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real secrets.

# Base URL of the Go REST API, including the /api/v1 prefix. Exposed to
# the browser (NEXT_PUBLIC_*) since catalog pages fetch it from both
# Server and Client Components.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Stage 9: real backend authentication (JWT access token in memory +
# HttpOnly refresh cookie) replaced every NEXT_PUBLIC_DEMO_*_ID shortcut —
# there is nothing left to configure here. Identity comes exclusively from
# POST /auth/login / GET /auth/me at runtime. Local dev credentials: every
# seeded account (see backend/seeds) shares the password documented in the
# backend README.
