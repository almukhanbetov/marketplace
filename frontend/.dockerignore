# environment / secrets — production API URL is passed as a build ARG,
# never read from a committed or local env file inside the image.
.env
.env.*

# dependencies (installed fresh in the deps stage)
node_modules

# next.js build output (regenerated in the builder stage)
.next
/out

# git
.git
.gitignore

# misc
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# IDE
.idea/
.vscode/
